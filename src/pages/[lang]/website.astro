---
import Layout from "@/layouts/Layout.astro";
import { getLangFromUrl, getStaticPaths } from "@i18n/utils";
import { getEntry } from "astro:content";

export { getStaticPaths };

const lang = getLangFromUrl(Astro.url);
const i18n = (await getEntry("i18n", lang))!.data;
---

<Layout pageTitle={i18n["website.title"]} tabTitle={i18n["website.tabTitle"]}>
    <ul>
        {
            i18n["website.tech"].map((tech) => (
                <li>
                    <Fragment set:html={tech} />
                </li>
            ))
        }
    </ul>
</Layout>
