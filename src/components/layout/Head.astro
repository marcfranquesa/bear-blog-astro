---
import { languageCodes, defaultLang } from "@i18n/langs";
import { getLangFromUrl, getUrlWithoutLang, useTranslatedPath, withBase } from "@i18n/utils";
import { getSiteSettings } from "@/lib/content/settings";
import { getContentImage } from "@/lib/content/images";

interface Props {
  title: string;
  tabTitle: string;
  description: string;
  image?: string;
}

const { title, tabTitle, description, image } = Astro.props;
const settings = await getSiteSettings();
const defaultOgImage = getContentImage(settings.profileImage);
const ogImage = image
  ? new URL(image, Astro.url)
  : new URL(defaultOgImage.src, Astro.site);

const currentLang = getLangFromUrl(Astro.url);
const urlWithoutLang = getUrlWithoutLang(Astro.url);
const canonicalURL = new URL(
  useTranslatedPath(currentLang)(urlWithoutLang),
  Astro.site,
);
const altLinks = languageCodes.map((lang) => ({
  lang,
  href: new URL(
    useTranslatedPath(lang)(urlWithoutLang),
    Astro.site,
  ),
}));
const xDefaultHref = new URL(
  useTranslatedPath(defaultLang)(urlWithoutLang),
  Astro.site,
);
---

{/* Global Metadata */}
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
<meta name="generator" content={Astro.generator} />

{/* Canonical URL */}
<link rel="canonical" href={canonicalURL} />

{/* Hreflang alternates */}
{
  altLinks.map(({ lang, href }) => (
    <link rel="alternate" hreflang={lang} href={href} />
  ))
}
<link rel="alternate" hreflang="x-default" href={xDefaultHref} />

{/* Primary Meta Tags */}
<title>{title ? `${tabTitle} | ` : ""}{settings.fullName}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

{/* Open Graph / Facebook */}
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />

{/* Twitter */}
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImage} />

{/* Sitemap */}
<link rel="sitemap" href={withBase("/sitemap-index.xml")} />

{/* Analytics */}
{settings.analyticsUrl && (
  <script
    data-goatcounter={settings.analyticsUrl}
    async
    src="//gc.zgo.at/count.js"></script>
)}
